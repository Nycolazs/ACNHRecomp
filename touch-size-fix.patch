+// input.touch_size (Settings > Controls, 50..160, default 100), read live so the slider acts at once.
+float touch_size_scale() {
+    static const bool wonder = std::strcmp(game::kInfo.id, "wonder") == 0;
+    if (wonder) return 1.0f;
+    return float(std::clamp(config_get_int("input.touch_size", 100), 50, 160)) / 100.0f;
+}
+
+// The resting hint of the stick: left half 0.27 (right half, mirrored, 0.73), past the d-pad column so they never overlap.
+float touch_stick_rest_x() { return touch_mirrored() ? 0.73f : 0.27f; }
+
 const TouchButton* touch_buttons(size_t& count) {
