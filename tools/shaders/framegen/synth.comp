#version 450
// Frame generation, last pass: the frame halfway between `prev` and `cur`. Each pixel picks, among the vectors around
// it (the field interpolated, the four nearest cells' own when they differ, and zero), the one whose two ends agree
// best, and shows the average of those ends. A pixel that did not change at all (HUD, still scenery) is copied as is,
// so it stays sharp. Where no vector fits (a motion edge: the running player over the scrolling ground, something
// uncovered), the pixel is the newer real frame's: that spot moves at 30 fps there but stays whole. The cross-fade it
// took before showed both positions half transparent, a ghost every other refresh that read as the player flickering.
// After a scene cut (most cells unmatched) the whole frame is the newer real one.
// Colours and errors are mediump (8-bit colours; Adreno: half registers, so more waves to hide the fetches, and
// double-rate ALU); pixel positions stay highp.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform mediump sampler2D prevc;
layout(set = 0, binding = 1) uniform mediump sampler2D curc;
layout(set = 0, binding = 2) uniform sampler2D field;
layout(set = 0, binding = 4, rgba8) uniform writeonly mediump image2D dst;
layout(set = 0, binding = 5, r32ui) uniform readonly uimage2D unmatched;  // smooth.comp's count
layout(push_constant) uniform P {
    ivec4 size;  // xy: the image's size; z: the unmatched cells above which the frame cross-fades (a scene cut)
    vec4 a;      // x: full pixels per field cell (16)
    vec4 b;
} p;

vec2 px, inv;
mediump vec3 best_col;
mediump float best_e, dm;  // dm: the local luma change (cur - prev), a fade: left out of the comparisons

mediump float err(mediump vec3 a, mediump vec3 b) { return dot(abs(a + dm - b), vec3(0.3333)); }

void try_v(vec2 v, mediump float bias) {
    mediump vec3 a = texture(prevc, (px - 0.5 * v) * inv).rgb;
    mediump vec3 b = texture(curc, (px + 0.5 * v) * inv).rgb;
    mediump float e = err(a, b) + bias;
    if (e < best_e) best_e = e, best_col = 0.5 * (a + b);
}

// A group covers 16x16 pixels (2x2 per invocation): the field cells around it (vector, luma change), read once.
shared vec3 cells[3][3];

bool cut;

void pixel(ivec2 q, ivec2 base) {
    if (any(greaterThanEqual(q, p.size.xy))) return;
    px = vec2(q) + 0.5;
    mediump vec3 a0 = texelFetch(prevc, q, 0).rgb, b0 = texelFetch(curc, q, 0).rgb;
    dm = 0.0;
    if (err(a0, b0) < 1.5 / 255.0) {
        imageStore(dst, q, vec4(0.5 * (a0 + b0), 1.0));
        return;
    }
    if (cut) {
        imageStore(dst, q, vec4(b0, 1.0));
        return;
    }
    vec2 f = px / p.a.x - 0.5;
    ivec2 i0 = ivec2(floor(f)) - base;
    mediump vec2 w = f - floor(f);
    vec3 c00 = cells[i0.y][i0.x], c10 = cells[i0.y][i0.x + 1];
    vec3 c01 = cells[i0.y + 1][i0.x], c11 = cells[i0.y + 1][i0.x + 1];
    vec3 cb = mix(mix(c00, c10, w.x), mix(c01, c11, w.x), w.y);
    vec2 vb = cb.xy;
    dm = cb.z;
    // How much of the newer real frame the pixel takes, eased in rather than switched: a hard switch drew seams (the
    // "cuts" of a moving object split between its interpolated and its newer position) along the cells' edges.
    // A change of brightness too large for a fade between two frames: a cut.
    mediump float newer = smoothstep(0.08, 0.16, abs(dm));
    // A motion edge: the cells around disagree (the player, whom the camera follows, over the scrolling ground). A
    // vector of the ground also makes its two ends agree there (ground on both sides of the player) and painted
    // ground over the player's legs and back: nothing is moved there, the pixel is the newer real frame's.
    float spread = max(max(length(c00.xy - vb), length(c10.xy - vb)), max(length(c01.xy - vb), length(c11.xy - vb)));
    newer = max(newer, smoothstep(1.0, 2.5, spread));
    if (newer >= 1.0) {
        imageStore(dst, q, vec4(b0, 1.0));
        return;
    }
    // Standing still (zero) first and unhandicapped: the field's vector has to do better to be taken.
    best_e = err(a0, b0);
    best_col = 0.5 * (a0 + b0);
    if (best_e > 0.015) try_v(vb, 0.01);
    // No vector makes the two ends agree well (a motion edge, something uncovered, effects that do not move): the
    // newer real frame, whole, from a smaller mismatch on than the old cross-fade took over.
    newer = max(newer, smoothstep(0.05, 0.12, best_e));
    imageStore(dst, q, vec4(mix(best_col, b0, newer), 1.0));
}

void main() {
    ivec2 t = ivec2(gl_LocalInvocationID.xy), g = ivec2(gl_WorkGroupID.xy);
    // The group's pixels need cells g-1 .. g+1 (cell size 16, sampled at cell centres).
    if (t.x < 3 && t.y < 3) {
        vec4 c = texelFetch(field, clamp(g - 1 + t, ivec2(0), textureSize(field, 0) - 1), 0);
        cells[t.y][t.x] = vec3(c.xy, c.w);
    }
    barrier();
    cut = imageLoad(unmatched, ivec2(0)).x > uint(p.size.z);
    inv = 1.0 / vec2(p.size.xy);
    for (int k = 0; k < 4; k++) pixel(g * 16 + t * 2 + ivec2(k & 1, k >> 1), g - 1);
}
