<?xml version="1.0" encoding="utf-8"?>
<!-- Home (android/java) asks for the game folder, then NativeActivity runs lib<game>.so (platform_android.cpp), which
     loads the game's code from that folder: the APK holds nothing of the game. Prepare (lib<game>_prepare.so) makes
     that folder on the phone from the ExeFS and RomFS the player extracted from their own copy. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="io.github.acnhrecomp"
          android:versionCode="1" android:versionName="dev">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true"/>
    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Sockets: Local Play (hle_ldn / ldn_link) and the online services; without it every socket() fails with EACCES -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Local Play's searches are broadcasts: Wi-Fi's multicast lock (platform_android.cpp wifi_multicast) lets them in -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Preparing the game folder on the phone (Prepare, PrepareService): an hour or more in a foreground service, with
         its progress in a notification and the CPU kept awake -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- About: the Instagram and GitHub buttons open those apps when installed (platform_android open_url_in_app) -->
    <queries>
        <package android:name="com.instagram.android"/>
        <package android:name="com.github.android"/>
    </queries>
    <application android:label="ACNH Recomp" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:hasCode="true" android:extractNativeLibs="true"
                 android:isGame="true" android:appCategory="game" android:largeHeap="true"
                 android:requestLegacyExternalStorage="true"
                 android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name="io.github.acnhrecomp.Home" android:exported="true"
                  android:theme="@android:style/Theme.Material.Light.NoActionBar"
                  android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
        </activity>
        <!-- The game folder prepared on the phone from the player's extracted ExeFS and RomFS: Home opens it for such a
             folder, the preparation's notification too (singleTop: brought back, not opened twice) -->
        <activity android:name="io.github.acnhrecomp.Prepare" android:exported="false" android:launchMode="singleTop"
                  android:theme="@android:style/Theme.Material.Light.NoActionBar"
                  android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation"/>
        <!-- The preparation itself (libacnh_prepare.so and the tools it runs: zig, the shader tool), which no other
             service type covers: recompiling and compiling the player's own game on the phone -->
        <service android:name="io.github.acnhrecomp.PrepareService" android:exported="false"
                 android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="Prepares the game folder from the player's own extracted game files: recompiling and compiling the game's code on the device, an hour or more"/>
        </service>
        <!-- The settings screen's folder picker (Saves: import, export, open folder): platform_android.cpp starts it -->
        <activity android:name="io.github.acnhrecomp.Picker" android:exported="false"
                  android:theme="@android:style/Theme.Translucent.NoTitleBar"
                  android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation"/>
        <!-- Nextendo's sign-in page (Online settings), in a WebView so the app stays in front: platform_android.cpp
             open_sign_in starts it. The return to 127.0.0.1 is the one plain-HTTP address (networkSecurityConfig). -->
        <activity android:name="io.github.acnhrecomp.SignIn" android:exported="false"
                  android:theme="@android:style/Theme.Material.NoActionBar"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation"/>
        <!-- windowSoftInputMode: the keyboard for the settings screen's text fields (TextInput.java) goes over the game,
             which keeps its window size, and comes up only when asked for -->
        <activity android:name="android.app.NativeActivity" android:exported="true"
                  android:screenOrientation="sensorLandscape" android:resizeableActivity="false"
                  android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
                  android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation"
                  android:theme="@style/Game">
            <meta-data android:name="android.app.lib_name" android:value="acnh"/>
            <!-- Draw under the camera cutout: the game fills the whole screen. -->
            <meta-data android:name="android.max_aspect" android:value="3.0"/>
        </activity>
    </application>
</manifest>
